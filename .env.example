# Use an absolute path to each existing library directory.
MOVIES_PATH=/path/to/movies
TV_PATH=/path/to/tv
STATE_PATH=./state
PUID=1000
PGID=1000

# Loopback works with an SSH tunnel or a reverse proxy on the host.
BIND_IP=127.0.0.1
WEB_PORT=8787

# First-login defaults. Use a unique value before allowing other hosts to connect.
TRANSLERR_SETUP_PASSWORD=translerr
# Set to 1 when the browser accesses Translerr over HTTPS.
TRANSLERR_SECURE_COOKIE=0
